# Large camera/AI/gallery payloads tracked via git-lfs (GitHub rejects >100MB
# in plain git; these also keep the working tree healthy).
*.apk filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text
libarcsoft*.so filter=lfs diff=lfs merge=lfs -text
libopencv_java4.so filter=lfs diff=lfs merge=lfs -text
libst_mobile.so filter=lfs diff=lfs merge=lfs -text
libcore_tokenizers.so filter=lfs diff=lfs merge=lfs -text
libXDocProcessSDK.so filter=lfs diff=lfs merge=lfs -text
**/libst_mobile.so filter=lfs diff=lfs merge=lfs -text
**/libXDocProcessSDK.so filter=lfs diff=lfs merge=lfs -text
